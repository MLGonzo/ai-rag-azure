# Copy this file to terraform.tfvars, then adjust values for your subscription.
# Do not commit terraform.tfvars. It is ignored by Git.

# AzureRM 4.x needs a subscription ID for plan/apply even when you use
# Azure CLI authentication. Prefer exporting ARM_SUBSCRIPTION_ID from the
# active Azure CLI subscription. Uncomment this only if you want to pin it here.
# subscription_id = "00000000-0000-0000-0000-000000000000"

location     = "uksouth"
project_name = "smallrag"

tags = {
  environment = "dev"
  owner       = "learning"
}

storage_container_name = "rag-documents"

# Basic is usually the smallest useful Azure AI Search SKU for vector examples.
# Use "free" only if your subscription has a free Search service available.
search_sku = "basic"

openai_account_sku_name = "S0"

chat_deployment_name = "gpt-4.1-mini"
chat_model_name       = "gpt-4.1-mini"
chat_model_version    = "2025-04-14"

embedding_deployment_name = "text-embedding-3-small"
embedding_model_name       = "text-embedding-3-small"
embedding_model_version    = "1"

# GlobalStandard is serverless/global standard deployment capacity, not PTU.
model_deployment_sku_name = "GlobalStandard"

# Capacity is expressed in thousands of TPM for Standard-like deployments.
# 100 means 100,000 TPM for chat; 30 means 30,000 TPM for embeddings.
chat_deployment_capacity_thousands      = 100
embedding_deployment_capacity_thousands = 30
