# Copy this file to .env during Part 1 setup.
# Do not put real secrets in .env.example, and do not commit your .env file.

# ---------------------------------------------------------------------------
# Azure account and resource placement
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-smallest-useful-rag-dev"
AZURE_LOCATION="uksouth"

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# Key-based auth is the expected local learning path for this series.
# Put the real key only in your local .env file, never in Git.
AZURE_OPENAI_API_KEY="replace-with-your-azure-openai-key"

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_INDEX_NAME="smallest-useful-rag"
# Key-based auth is the expected local learning path for this series.
# Put the real key only in your local .env file, never in Git.
AZURE_SEARCH_API_KEY="replace-with-your-search-admin-or-query-key"

# ---------------------------------------------------------------------------
# Azure Storage
# ---------------------------------------------------------------------------
# Blob Storage is the durable source-document location in the target architecture.
# Later parts may also read from local sample docs while teaching ingestion.
# Terraform creates this account in Part 1. Use terraform output app_env_values.
AZURE_STORAGE_ACCOUNT_NAME="replace-with-storage-account-name"
AZURE_STORAGE_CONTAINER_NAME="rag-documents"

# ---------------------------------------------------------------------------
# Local app and ingestion defaults
# ---------------------------------------------------------------------------
APP_HOST="127.0.0.1"
APP_PORT="8000"
LOG_LEVEL="INFO"
DATA_DIR="data"
SAMPLE_DOCS_DIR="data/sample-docs"
CHUNK_SIZE="800"
CHUNK_OVERLAP="120"
RETRIEVAL_TOP_K="5"
