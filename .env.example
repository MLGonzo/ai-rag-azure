# Copy this file to .env during local setup.
# Do not put real secrets in .env.example, and do not commit your .env file.

# ---------------------------------------------------------------------------
# Azure account and resource placement
# ---------------------------------------------------------------------------
# These IDs are reference values for local scripts and later parts. They do not
# replace `az login`, and Terraform does not read them from .env.
# To fill them from your active Azure CLI context:
# az account show --query '{subscriptionId:id, tenantId:tenantId}' --output table
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-smallest-useful-rag-dev"
AZURE_LOCATION="uksouth"

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4.1-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# Key-based auth is the expected local learning path for this series.
# Put the real key only in your local .env file, never in Git.
AZURE_OPENAI_API_KEY="replace-with-your-azure-openai-key"

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_INDEX_NAME="smallest-useful-rag"
# Key-based auth is the expected local learning path for this series.
# Put the real key only in your local .env file, never in Git.
AZURE_SEARCH_API_KEY="replace-with-your-search-admin-or-query-key"

# ---------------------------------------------------------------------------
# Azure Storage
# ---------------------------------------------------------------------------
# Blob Storage is the durable source-document location in the target architecture.
# Terraform creates this account in Part 1. Use terraform output app_env_values.
AZURE_STORAGE_ACCOUNT_NAME="replace-with-storage-account-name"
AZURE_STORAGE_ACCOUNT_URL="https://replace-with-storage-account-name.blob.core.windows.net/"
AZURE_STORAGE_CONTAINER_NAME="rag-documents"
# Required by scripts/upload_docs.py. This value is secret, so keep the real
# value only in your local .env file.
# az storage account keys list --resource-group "$AZURE_RESOURCE_GROUP" --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --query "[0].value" --output tsv
AZURE_STORAGE_ACCOUNT_KEY="replace-with-storage-account-key"
# Optional prefix for uploaded blob names. Leave empty for this lesson.
AZURE_STORAGE_BLOB_PREFIX=""

# ---------------------------------------------------------------------------
# Local app and ingestion defaults
# ---------------------------------------------------------------------------
APP_HOST="127.0.0.1"
APP_PORT="8000"
LOG_LEVEL="INFO"
DATA_DIR="data"
SAMPLE_DOCS_DIR="data/sample-docs"
CHUNK_SIZE="800"
CHUNK_OVERLAP="120"
RETRIEVAL_TOP_K="5"
